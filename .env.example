# YouTube Data API v3
# Get a key at https://console.cloud.google.com → APIs & Services → YouTube Data API v3
VITE_YOUTUBE_API_KEY=

# Twitch Helix API
# Register an app at https://dev.twitch.tv/console/apps
# Get an app access token: https://dev.twitch.tv/docs/authentication/getting-tokens-oauth/#client-credentials-grant-flow
VITE_TWITCH_CLIENT_ID=
VITE_TWITCH_ACCESS_TOKEN=
